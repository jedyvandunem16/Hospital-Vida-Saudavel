# ================================================================
#  GHospital — .env.example
#  Copia este ficheiro para .env e preenche os valores reais.
#  NUNCA versiones o .env no Git — já está no .gitignore.
#
#  Gerar JWT_SECRET seguro:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ================================================================

# ── Servidor ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_NAME="Hospital Vida Saudável"

# ── Base de Dados MySQL ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=SUBSTITUIR
DB_PASSWORD=SUBSTITUIR
DB_NAME=hospital_vida_saudavel

# ── JWT ──────────────────────────────────────────────────────────
# Gera com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=SUBSTITUIR_COM_STRING_ALEATORIA_DE_128_CHARS
JWT_EXPIRES_IN=7d

# ── Email (Nodemailer — SMTP) ────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=SUBSTITUIR
EMAIL_PASS=SUBSTITUIR
EMAIL_FROM="Hospital Vida Saudável <SUBSTITUIR>"

# ── CORS ─────────────────────────────────────────────────────────
# Em produção: URL exacta do frontend (sem barra final)
# Exemplo: https://meusite.co.ao
FRONTEND_URL=http://localhost:5500

# ── Admin padrão (usado apenas no primeiro db:setup) ─────────────
ADMIN_NOME=Administrador
ADMIN_EMAIL=SUBSTITUIR
ADMIN_PASSWORD=SUBSTITUIR_MIN_12_CHARS
